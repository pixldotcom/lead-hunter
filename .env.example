# Server-only Supabase configuration. Empty values fail closed.
# The browser calls same-origin Node APIs; no VITE_ credentials are needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:5173
# Never configure a service-role/sb_secret key here. The app uses each user's JWT and RLS.
