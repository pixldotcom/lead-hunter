# Server-only Supabase configuration. Empty values fail closed.
# The browser calls same-origin Node APIs; no VITE_ credentials are needed.
# npm run dev loads .env then optional .env.local; shell variables take precedence.
# Fill these with the EXISTING project's URL and publishable/anon key.
# .env.test.local is for the separate integration runner, not npm run dev.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:5173
# Authentication > Users: UUID and email of the ONE manually created owner.
OWNER_USER_ID=
OWNER_EMAIL=
# Never configure a service-role/sb_secret key here. The app uses each user's JWT and RLS.
